# Copy to gym/milvus_override.yaml and set milvus_uri to an address THIS
# machine can open on TCP 19530 (LoadBalancer / VPN / SSH tunnel).
# Kubernetes ClusterIPs such as 10.185.x.x are NOT reachable from AWS or a laptop.
fact_checking_reward_model_dev:
  resources_servers:
    fact_checking_reward_model_dev:
      retrieval_backend: milvus
      milvus_uri: "http://127.0.0.1:19530"
      milvus_collection_name: finewebBrowsecomp322M
      milvus_embedding_model: google/embeddinggemma-300m
      milvus_embedding_device: cpu
      milvus_embedding_base_url: "http://127.0.0.1:8002/v1"
      milvus_anns_field: emb
      milvus_search_list: 256
      tantivy_index_dir: null
      corpus_db_path: null
      judge_model_server:
        type: responses_api_models
        name: fact_checking_dev_judge_model

fact_checking_dev_judge_model:
  responses_api_models:
    vllm_model:
      entrypoint: app.py
      base_url: "http://127.0.0.1:8001/v1"
      api_key: dummy_key
      model: nvidia/NVIDIA-Nemotron-Nano-9B-v2
      uses_reasoning_parser: false
      spinup_server: false
      router_dp_size: 1
      server_args: {}
